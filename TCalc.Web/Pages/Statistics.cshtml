@page
@model TCalc.Web.Pages.StatisticsModel
@{
    ViewData["Title"] = "Statistics Calculator";
}

<div x-data="statsCalc()" x-init="initPreload()">
    <!-- Page header -->
    <div class="mb-4">
        <h1 class="calc-title mb-1">Statistics Calculator</h1>
        <p class="text-muted mb-0">Enter data manually or upload a CSV file, then explore descriptive statistics, visualizations, and regression models.</p>
    </div>

    <!-- ─── Save / Load / Export toolbar ─── -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="calc-container mb-4 py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small fw-bold text-muted text-uppercase me-1">💾 Data Management</span>

                <!-- Save button -->
                <button type="button" class="btn btn-sm btn-outline-primary"
                        x-on:click="showSaveModal = true"
                        :disabled="csvColumns.length === 0"
                        title="Save current CSV data to your account">
                    💾 Save Data Set
                </button>

                <!-- Load picker -->
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        x-on:click="loadDataSetList()"
                        title="Load a saved data set">
                    📂 Load Data Set
                </button>

                <!-- Export CSV -->
                <button type="button" class="btn btn-sm btn-outline-success"
                        x-on:click="exportCurrentCsv()"
                        :disabled="csvColumns.length === 0"
                        title="Download current data as CSV">
                    ⬇ Export CSV
                </button>

                <a asp-page="/Dashboard" class="btn btn-sm btn-outline-secondary ms-auto" title="Go to Dashboard">
                    📋 Dashboard
                </a>
            </div>

            <!-- Save modal -->
            <template x-if="showSaveModal">
                <div class="mt-3 p-3 border rounded" style="background: var(--tc-bg-secondary);">
                    <h6 class="fw-bold mb-2">Save Data Set</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Name (required)"
                                   x-model="saveName" />
                        </div>
                        <div class="col-sm-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Description (optional)"
                                   x-model="saveDescription" />
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" x-on:click="saveDataSet()"
                                :disabled="!saveName.trim()">
                            Save
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click="showSaveModal = false">
                            Cancel
                        </button>
                        <span class="small align-self-center" x-text="saveStatus"></span>
                    </div>
                </div>
            </template>

            <!-- Load picker list -->
            <template x-if="showLoadPicker">
                <div class="mt-3 p-3 border rounded" style="background: var(--tc-bg-secondary);">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0">Load Data Set</h6>
                        <button type="button" class="btn-close btn-sm" x-on:click="showLoadPicker = false"></button>
                    </div>
                    <template x-if="savedDataSets.length === 0">
                        <p class="small text-muted mb-0">No saved data sets found.</p>
                    </template>
                    <div class="list-group list-group-flush" style="max-height:200px; overflow-y:auto;">
                        <template x-for="ds in savedDataSets" :key="ds.id">
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3"
                               :href="'?loadId=' + ds.id">
                                <div>
                                    <span class="fw-semibold" x-text="ds.name"></span>
                                    <span class="small text-muted ms-2" x-text="ds.description || ''"></span>
                                </div>
                                <span class="badge bg-body-secondary text-body-secondary" x-text="ds.updatedAt"></span>
                            </a>
                        </template>
                    </div>
                </div>
            </template>
        </div>
    }
    else
    {
        <div class="alert alert-light border py-2 px-3 small mb-4">
            💡 <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to save and load your data sets.
        </div>
    }

    <!-- Global error / info banner -->
    <template x-if="chartError">
        <div class="alert alert-warning d-flex align-items-center py-2 px-3 small mb-3" role="alert">
            <span class="flex-fill" x-text="chartError"></span>
            <button type="button" class="btn-close btn-sm ms-2" aria-label="Close" x-on:click="chartError = ''"></button>
        </div>
    </template>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 1 — Data Input                             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4">
        <!-- Manual data entry -->
        <div class="col-lg-6">
            <div class="calc-container h-100">
                <div class="stat-section-header">
                    <span class="stat-section-icon">📊</span>
                    <div>
                        <h5 class="mb-0 fw-bold">Manual Data Entry</h5>
                        <small class="text-muted">Type or paste values separated by commas, spaces, or newlines</small>
                    </div>
                </div>

                <textarea class="form-control font-monospace stat-data-input"
                          x-model="rawData" rows="8"
                          placeholder="e.g.  12, 15, 18, 22, 25, 30, 35&#10;&#10;Tip: Paste a column of numbers from a spreadsheet"></textarea>

                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-primary flex-fill" x-on:click="compute()">
                        🔢 Compute Stats
                    </button>
                    <button type="button" class="btn btn-outline-primary"
                            x-on:click="visualize()" :disabled="!rawData.trim()"
                            title="Generate histogram and box plot">
                        📊 Visualize
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            x-on:click="clearAll()" title="Clear all data">
                        ✕
                    </button>
                </div>
            </div>
        </div>

        <!-- CSV upload -->
        <div class="col-lg-6">
            <div class="calc-container h-100">
                <div class="stat-section-header">
                    <span class="stat-section-icon">📁</span>
                    <div>
                        <h5 class="mb-0 fw-bold">CSV File Upload</h5>
                        <small class="text-muted">Upload a .csv or .txt file with a header row</small>
                    </div>
                </div>

                <div class="mb-3">
                    <input type="file" class="form-control" accept=".csv,.txt"
                           x-ref="csvInput" x-on:change="uploadCsv()" />
                </div>

                <!-- Column cards after upload -->
                <template x-if="csvColumns.length > 0">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-bold text-muted text-uppercase">Available Columns</span>
                            <span class="badge bg-secondary" x-text="csvRowCount + ' rows loaded'"></span>
                        </div>
                        <div class="stat-csv-column-list">
                            <template x-for="col in csvColumns" :key="col">
                                <div class="stat-csv-column-card">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-semibold" x-text="col"></span>
                                        <span class="badge bg-body-secondary text-body-secondary"
                                              x-text="(csvData[col] || []).length + ' values'"></span>
                                    </div>
                                    <div class="text-muted small text-truncate mb-2"
                                         x-text="(csvData[col] || []).slice(0, 5).join(', ') + ((csvData[col] || []).length > 5 ? ' …' : '')"></div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button type="button" class="btn btn-outline-primary btn-sm stat-csv-btn"
                                                x-on:click="useCsvColumnForAnalysis(col)"
                                                title="Load into data entry for descriptive stats">
                                            📊 Analyze
                                        </button>
                                        <button type="button" class="btn btn-outline-success btn-sm stat-csv-btn"
                                                x-on:click="useCsvColumnForReg(col, 'x')"
                                                title="Use as regression X values">
                                            X ↗
                                        </button>
                                        <button type="button" class="btn btn-outline-warning btn-sm stat-csv-btn"
                                                x-on:click="useCsvColumnForReg(col, 'y')"
                                                title="Use as regression Y values">
                                            Y ↗
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </template>

                <template x-if="csvColumns.length === 0">
                    <div class="text-center text-muted py-4">
                        <div style="font-size: 2.5rem; opacity: 0.3;">📂</div>
                        <p class="small mb-0 mt-2">Upload a CSV file to see columns here</p>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 2 — Results & Visualizations               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4" x-show="statsHtml || showHistogram || showBoxPlot" x-cloak>
        <!-- Descriptive statistics table -->
        <div class="col-xl-5 col-lg-6">
            <div class="calc-container h-100">
                <div class="stat-section-header">
                    <span class="stat-section-icon">📋</span>
                    <h5 class="mb-0 fw-bold">Descriptive Statistics</h5>
                </div>
                <div id="stats-result" x-html="statsHtml"></div>
            </div>
        </div>

        <!-- Charts -->
        <div class="col-xl-7 col-lg-6">
            <div class="calc-container h-100">
                <div class="stat-section-header">
                    <span class="stat-section-icon">📈</span>
                    <h5 class="mb-0 fw-bold">Visualizations</h5>
                </div>
                <div class="stat-chart-container mb-3" x-show="showHistogram" x-cloak>
                    <h6 class="small fw-bold mb-2">Histogram</h6>
                    <canvas id="histogramCanvas"></canvas>
                </div>
                <div class="stat-chart-container" x-show="showBoxPlot" x-cloak>
                    <h6 class="small fw-bold mb-2">Box Plot (Five-Number Summary)</h6>
                    <canvas id="boxPlotCanvas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 3 — Regression Analysis                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">📐</span>
            <div>
                <h5 class="mb-0 fw-bold">Regression Analysis</h5>
                <small class="text-muted">Fit a trend line to paired (X, Y) data — type values manually or use CSV columns above</small>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: inputs & controls -->
            <div class="col-lg-5">
                <!-- Quick-fill from CSV (only visible when CSV data exists) -->
                <template x-if="csvColumns.length > 0">
                    <div class="stat-csv-quickfill mb-3">
                        <p class="small fw-bold mb-2">⚡ Quick-fill from CSV</p>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small mb-1">X column</label>
                                <div class="input-group input-group-sm">
                                    <select class="form-select form-select-sm" x-model="csvRegXCol">
                                        <template x-for="col in csvColumns" :key="'rx-'+col">
                                            <option :value="col" x-text="col"></option>
                                        </template>
                                    </select>
                                    <button class="btn btn-outline-success btn-sm" type="button"
                                            x-on:click="fillRegFromCsv('x')">
                                        Fill
                                    </button>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Y column</label>
                                <div class="input-group input-group-sm">
                                    <select class="form-select form-select-sm" x-model="csvRegYCol">
                                        <template x-for="col in csvColumns" :key="'ry-'+col">
                                            <option :value="col" x-text="col"></option>
                                        </template>
                                    </select>
                                    <button class="btn btn-outline-warning btn-sm" type="button"
                                            x-on:click="fillRegFromCsv('y')">
                                        Fill
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">X values</label>
                        <textarea class="form-control font-monospace stat-data-input"
                                  x-model="regX" rows="6"
                                  placeholder="1, 2, 3, 4, 5"></textarea>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">Y values</label>
                        <textarea class="form-control font-monospace stat-data-input"
                                  x-model="regY" rows="6"
                                  placeholder="2.1, 4.0, 5.9, 8.1, 10.2"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-end mb-3">
                    <div class="flex-fill">
                        <label class="form-label small fw-semibold mb-1">Polynomial Degree</label>
                        <select class="form-select" x-model.number="regDegree">
                            <option value="1">1 — Linear</option>
                            <option value="2">2 — Quadratic</option>
                            <option value="3">3 — Cubic</option>
                            <option value="4">4 — Quartic</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary" x-on:click="runRegression()">
                        📈 Fit Model
                    </button>
                </div>

                <!-- Regression result -->
                <template x-if="regResult">
                    <div class="stat-regression-result">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success">Fitted</span>
                            <span class="small fw-bold">Regression Result</span>
                        </div>
                        <div class="font-monospace fw-bold" style="font-size: .95rem;" x-text="regResult.equation"></div>
                        <div class="small text-muted mt-1">
                            R² = <span class="fw-bold" x-text="regResult.rSquared.toFixed(6)"></span>
                            <span class="ms-2"
                                  x-text="regResult.rSquared >= 0.99 ? '✨ Excellent fit' : regResult.rSquared >= 0.95 ? '👍 Good fit' : regResult.rSquared >= 0.8 ? '⚠️ Moderate fit' : '❌ Poor fit'"></span>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Right: scatter chart -->
            <div class="col-lg-7">
                <div class="stat-chart-container stat-chart-container-tall" x-show="showScatter" x-cloak>
                    <h6 class="small fw-bold mb-2">Scatter Plot &amp; Regression</h6>
                    <canvas id="scatterCanvas"></canvas>
                </div>
                <template x-if="!showScatter">
                    <div class="text-center text-muted py-5">
                        <div style="font-size: 3rem; opacity: 0.2;">📈</div>
                        <p class="small mb-0 mt-2">Enter X and Y data, then click <strong>Fit Model</strong> to see the scatter plot</p>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 4 — Probability Distributions              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">🎲</span>
            <div>
                <h5 class="mb-0 fw-bold">Probability Distributions</h5>
                <small class="text-muted">Normal, Binomial, and Poisson — compute probabilities and visualise PDF/PMF</small>
            </div>
        </div>

        <!-- Distribution type selector -->
        <div class="prob-type-selector mb-3">
            <button type="button" class="prob-type-btn" :class="probDist === 'normal' && 'active'"
                    x-on:click="probDist = 'normal'">Normal</button>
            <button type="button" class="prob-type-btn" :class="probDist === 'binomial' && 'active'"
                    x-on:click="probDist = 'binomial'">Binomial</button>
            <button type="button" class="prob-type-btn" :class="probDist === 'poisson' && 'active'"
                    x-on:click="probDist = 'poisson'">Poisson</button>
        </div>

        <template x-if="probDefaultsApplied">
            <div class="alert alert-info d-flex align-items-center py-2 px-3 small mb-3">
                <span class="flex-fill">📊 Parameters auto-filled from your dataset (μ = <span x-text="probMean"></span>, σ = <span x-text="probStdDev"></span>, n = <span x-text="probN"></span>). Adjust as needed.</span>
                <button type="button" class="btn-close btn-sm ms-2" aria-label="Close" x-on:click="probDefaultsApplied = false"></button>
            </div>
        </template>

        <div class="row g-4">
            <!-- Left: inputs & results -->
            <div class="col-lg-5">
                <!-- Normal parameters -->
                <template x-if="probDist === 'normal'">
                    <div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">Mean (μ)</label>
                                <input type="number" class="form-control" x-model.number="probMean" step="any" placeholder="0" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">Std Dev (σ)</label>
                                <input type="number" class="form-control" x-model.number="probStdDev" step="any" min="0.001" placeholder="1" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">
                                Query value (x) <span class="text-muted fw-normal">— optional, computes P(X ≤ x)</span>
                            </label>
                            <input type="number" class="form-control" x-model="probX" step="any" placeholder="e.g. 1.96" />
                        </div>
                    </div>
                </template>

                <!-- Binomial parameters -->
                <template x-if="probDist === 'binomial'">
                    <div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">Trials (n)</label>
                                <input type="number" class="form-control" x-model.number="probN" min="0" max="1000" step="1" placeholder="10" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">Probability (p)</label>
                                <input type="number" class="form-control" x-model.number="probP" min="0" max="1" step="0.01" placeholder="0.5" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">
                                Query value (k) <span class="text-muted fw-normal">— optional, computes P(X = k) and P(X ≤ k)</span>
                            </label>
                            <input type="number" class="form-control" x-model="probK" min="0" step="1" placeholder="e.g. 5" />
                        </div>
                    </div>
                </template>

                <!-- Poisson parameters -->
                <template x-if="probDist === 'poisson'">
                    <div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">Rate (λ)</label>
                                <input type="number" class="form-control" x-model.number="probLambda" min="0.01" max="1000" step="any" placeholder="5" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">
                                    Query value (k) <span class="text-muted fw-normal">— optional</span>
                                </label>
                                <input type="number" class="form-control" x-model="probK" min="0" step="1" placeholder="e.g. 3" />
                            </div>
                        </div>
                    </div>
                </template>

                <button type="button" class="btn btn-primary w-100 mb-3" x-on:click="computeProbability()">
                    🎲 Compute Distribution
                </button>

                <!-- Results -->
                <template x-if="probResult">
                    <div class="prob-result-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary">Result</span>
                            <span class="small fw-bold" x-text="probDist === 'normal' ? 'Normal Distribution' : probDist === 'binomial' ? 'Binomial Distribution' : 'Poisson Distribution'"></span>
                        </div>

                        <!-- Summary stats -->
                        <div class="prob-result-stats mb-2">
                            <template x-if="probResult.type === 'normal'">
                                <div>
                                    <span class="prob-stat-label">μ =</span> <span class="prob-stat-value" x-text="probResult.mean"></span>
                                    <span class="prob-stat-label ms-3">σ =</span> <span class="prob-stat-value" x-text="probResult.stdDev"></span>
                                </div>
                            </template>
                            <template x-if="probResult.type === 'binomial'">
                                <div>
                                    <span class="prob-stat-label">E[X] =</span> <span class="prob-stat-value" x-text="probResult.expectedValue"></span>
                                    <span class="prob-stat-label ms-3">Var =</span> <span class="prob-stat-value" x-text="probResult.variance"></span>
                                    <span class="prob-stat-label ms-3">σ =</span> <span class="prob-stat-value" x-text="probResult.stdDev"></span>
                                </div>
                            </template>
                            <template x-if="probResult.type === 'poisson'">
                                <div>
                                    <span class="prob-stat-label">E[X] = λ =</span> <span class="prob-stat-value" x-text="probResult.expectedValue"></span>
                                    <span class="prob-stat-label ms-3">Var =</span> <span class="prob-stat-value" x-text="probResult.variance"></span>
                                    <span class="prob-stat-label ms-3">σ =</span> <span class="prob-stat-value" x-text="probResult.stdDev"></span>
                                </div>
                            </template>
                        </div>

                        <!-- Queried probability -->
                        <template x-if="probResult.type === 'normal' && probResult.queriedX !== null && probResult.queriedX !== undefined">
                            <div class="prob-query-result">
                                <div class="small text-muted mb-1">At x = <span x-text="probResult.queriedX"></span>:</div>
                                <div class="font-monospace">
                                    <span class="prob-stat-label">f(x) =</span> <span class="fw-bold" x-text="probResult.pdfAtX?.toFixed(8)"></span>
                                </div>
                                <div class="font-monospace">
                                    <span class="prob-stat-label">P(X ≤ x) =</span> <span class="fw-bold" x-text="probResult.cdfAtX?.toFixed(8)"></span>
                                    <span class="text-muted ms-2" x-text="'(' + (probResult.cdfAtX * 100).toFixed(4) + '%)'"></span>
                                </div>
                            </div>
                        </template>
                        <template x-if="(probResult.type === 'binomial' || probResult.type === 'poisson') && probResult.queriedK !== null && probResult.queriedK !== undefined">
                            <div class="prob-query-result">
                                <div class="small text-muted mb-1">At k = <span x-text="probResult.queriedK"></span>:</div>
                                <div class="font-monospace">
                                    <span class="prob-stat-label">P(X = k) =</span> <span class="fw-bold" x-text="probResult.pmfAtK?.toFixed(8)"></span>
                                    <span class="text-muted ms-2" x-text="'(' + (probResult.pmfAtK * 100).toFixed(4) + '%)'"></span>
                                </div>
                                <div class="font-monospace">
                                    <span class="prob-stat-label">P(X ≤ k) =</span> <span class="fw-bold" x-text="probResult.cdfAtK?.toFixed(8)"></span>
                                    <span class="text-muted ms-2" x-text="'(' + (probResult.cdfAtK * 100).toFixed(4) + '%)'"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>
            </div>

            <!-- Right: chart -->
            <div class="col-lg-7">
                <div class="stat-chart-container stat-chart-container-tall" x-show="showProbChart" x-cloak>
                    <h6 class="small fw-bold mb-2" x-text="probDist === 'normal' ? 'Probability Density Function (PDF)' : 'Probability Mass Function (PMF)'"></h6>
                    <canvas id="probChartCanvas"></canvas>
                </div>
                <template x-if="!showProbChart">
                    <div class="text-center text-muted py-5">
                        <div style="font-size: 3rem; opacity: 0.2;">🎲</div>
                        <p class="small mb-0 mt-2">Set parameters and click <strong>Compute Distribution</strong> to see the chart</p>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 5 — Time Series Analysis                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">📉</span>
            <div>
                <h5 class="mb-0 fw-bold">Time Series Analysis</h5>
                <small class="text-muted">Decompose trends, explore autocorrelation, and forecast future values</small>
            </div>
        </div>

        <!-- Data Input -->
        <div class="row g-4 mb-3">
            <div class="col-lg-6">
                <label class="form-label small fw-semibold">Time Series Data</label>
                <textarea class="form-control font-monospace stat-data-input" rows="4"
                          x-model="tsData"
                          placeholder="Enter comma-separated values (time-ordered), e.g.: 112, 118, 132, 129, 121, 135, 148, 148, 136, 119, 104, 118"></textarea>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="tsLoadPreset('airline')">✈ Airline Passengers</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="tsLoadPreset('temps')">🌡️ Monthly Temps</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="tsLoadPreset('sales')">💰 Quarterly Sales</button>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Seasonal Period</label>
                        <select class="form-select form-select-sm" x-model.number="tsPeriod">
                            <option value="4">4 (Quarterly)</option>
                            <option value="7">7 (Weekly)</option>
                            <option value="12">12 (Monthly)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Forecast Horizon</label>
                        <input type="range" class="form-range mt-2" x-model.number="tsHorizon" min="1" max="12" step="1">
                        <span class="small text-muted" x-text="tsHorizon + ' periods'"></span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-primary btn-sm" x-on:click="tsAnalyze()">
                        📉 Analyze Series
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" x-on:click="tsReset()">
                        Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div x-show="tsHasResult" x-transition>
            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="stat-chart-container">
                        <h6 class="small fw-bold mb-2">Original + Trend</h6>
                        <canvas id="tsDecompChart" style="height:250px;"></canvas>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="stat-chart-container">
                        <h6 class="small fw-bold mb-2">Autocorrelation (ACF)</h6>
                        <canvas id="tsAcfChart" style="height:250px;"></canvas>
                    </div>
                </div>
            </div>
            <div class="stat-chart-container mb-3">
                <h6 class="small fw-bold mb-2">Forecast</h6>
                <canvas id="tsForecastChart" style="height:250px;"></canvas>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 6 — PCA Visualizer                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">🔬</span>
            <div>
                <h5 class="mb-0 fw-bold">PCA Visualizer (2-D)</h5>
                <small class="text-muted">See how principal components find directions of maximum spread in your data</small>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">X values</label>
                        <textarea class="form-control font-monospace stat-data-input" rows="4"
                                  x-model="pcaX" placeholder="1, 2, 3, 4, 5"></textarea>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Y values</label>
                        <textarea class="form-control font-monospace stat-data-input" rows="4"
                                  x-model="pcaY" placeholder="2.1, 4.0, 5.9, 8.1, 10.2"></textarea>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="pcaLoadPreset('correlated')">📈 Correlated</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="pcaLoadPreset('uncorrelated')">🔀 Uncorrelated</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="pcaLoadPreset('elliptical')">🔵 Elliptical</button>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm" x-on:click="pcaCompute()">
                        🔬 Compute PCA
                    </button>
                    <button type="button" class="btn btn-sm"
                            :class="pcaShowProjection ? 'btn-warning' : 'btn-outline-warning'"
                            x-on:click="pcaToggleProjection()" x-show="pcaHasResult">
                        <span x-text="pcaShowProjection ? '↩ Show Original' : '➡ Project onto PC1'"></span>
                    </button>
                </div>

                <!-- PCA Results -->
                <div x-show="pcaHasResult" x-transition>
                    <div class="prob-result-grid" style="grid-template-columns:1fr 1fr;">
                        <div class="prob-result-item">
                            <div class="prob-result-label">PC1 Explained</div>
                            <div class="prob-result-value" x-text="pcaResult ? (pcaResult.explainedVariance1 * 100).toFixed(1) + '%' : ''"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">PC2 Explained</div>
                            <div class="prob-result-value" x-text="pcaResult ? (pcaResult.explainedVariance2 * 100).toFixed(1) + '%' : ''"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">Eigenvalue 1</div>
                            <div class="prob-result-value" x-text="pcaResult ? pcaResult.eigenvalue1.toFixed(4) : ''"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">Eigenvalue 2</div>
                            <div class="prob-result-value" x-text="pcaResult ? pcaResult.eigenvalue2.toFixed(4) : ''"></div>
                        </div>
                    </div>
                    <div class="prob-teach-card mt-2" style="font-size:.85rem;">
                        💡 <strong>PCA finds the directions of maximum spread (variance) — PC1 captures the most information.</strong>
                        Click "Project onto PC1" to see dimensionality reduction in action.
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="stat-chart-container stat-chart-container-tall" x-show="pcaHasResult" x-cloak>
                    <h6 class="small fw-bold mb-2">Scatter Plot &amp; Principal Components</h6>
                    <canvas id="pcaChart"></canvas>
                </div>
                <div x-show="!pcaHasResult" class="text-center text-muted py-5">
                    <div style="font-size: 3rem; opacity: 0.2;">🔬</div>
                    <p class="small mb-0 mt-2">Enter X and Y data, then click <strong>Compute PCA</strong></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 7 — Multiple Regression                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">📊</span>
            <div>
                <h5 class="mb-0 fw-bold">Multiple Regression</h5>
                <small class="text-muted">Fit a model with multiple predictor variables: ŷ = β₀ + β₁x₁ + β₂x₂ + …</small>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <!-- Predictor inputs -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Predictors (one column per line, comma-separated values)</label>
                    <template x-for="(col, i) in mrPredictors" :key="i">
                        <div class="input-group input-group-sm mb-1">
                            <span class="input-group-text" style="min-width:40px;" x-text="'x' + (i+1)"></span>
                            <input type="text" class="form-control font-monospace"
                                   x-model="mrPredictors[i]" placeholder="1, 2, 3, 4, 5">
                            <button class="btn btn-outline-danger" type="button"
                                    x-on:click="mrPredictors.splice(i, 1)" x-show="mrPredictors.length > 1">✕</button>
                        </div>
                    </template>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-1"
                            x-on:click="mrPredictors.push('')" :disabled="mrPredictors.length >= 5">
                        + Add Predictor
                    </button>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold">Response (Y)</label>
                    <input type="text" class="form-control form-control-sm font-monospace"
                           x-model="mrY" placeholder="2.1, 4.0, 5.9, 8.1, 10.2">
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm" x-on:click="mrCompute()">
                        📊 Fit Multiple Regression
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="mrLoadExample()">Load Example</button>
                </div>

                <!-- Results -->
                <div x-show="mrHasResult" x-transition>
                    <div class="font-monospace fw-bold mb-2" style="font-size:.9rem;" x-text="mrEquation"></div>
                    <div class="prob-result-grid" style="grid-template-columns:1fr 1fr;">
                        <div class="prob-result-item">
                            <div class="prob-result-label">R²</div>
                            <div class="prob-result-value" x-text="mrR2"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">Adjusted R²</div>
                            <div class="prob-result-value" x-text="mrAdjR2"></div>
                        </div>
                    </div>
                    <!-- Coefficients table -->
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-bordered" style="font-size:.8rem;">
                            <thead><tr><th>Coeff</th><th>Value</th><th>Std Error</th><th>t-stat</th></tr></thead>
                            <tbody>
                                <template x-for="(c, i) in mrCoeffs" :key="i">
                                    <tr>
                                        <td x-text="i === 0 ? 'β₀ (intercept)' : 'β' + i"></td>
                                        <td x-text="c.toFixed(4)"></td>
                                        <td x-text="mrSE[i] ? mrSE[i].toFixed(4) : '—'"></td>
                                        <td x-text="mrTStats[i] ? mrTStats[i].toFixed(4) : '—'"></td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="stat-chart-container stat-chart-container-tall" x-show="mrHasResult" x-cloak>
                    <h6 class="small fw-bold mb-2">Actual vs Fitted</h6>
                    <canvas id="mrChart"></canvas>
                </div>
                <div x-show="!mrHasResult" class="text-center text-muted py-5">
                    <div style="font-size: 3rem; opacity: 0.2;">📊</div>
                    <p class="small mb-0 mt-2">Enter predictor and response data, then click <strong>Fit Multiple Regression</strong></p>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SECTION 8 — Logistic Regression                    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="calc-container mb-4">
        <div class="stat-section-header">
            <span class="stat-section-icon">🎯</span>
            <div>
                <h5 class="mb-0 fw-bold">Logistic Regression</h5>
                <small class="text-muted">Model binary outcomes: P(y=1|x) = 1/(1 + e^(−(β₀ + β₁x)))</small>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">X (predictor)</label>
                        <textarea class="form-control font-monospace stat-data-input" rows="4"
                                  x-model="logX" placeholder="1, 2, 3, 4, 5, 6, 7, 8"></textarea>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Y (0 or 1)</label>
                        <textarea class="form-control font-monospace stat-data-input" rows="4"
                                  x-model="logY" placeholder="0, 0, 0, 1, 0, 1, 1, 1"></textarea>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="logLoadPreset('exam')">📝 Exam Pass</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            x-on:click="logLoadPreset('medical')">🏥 Treatment</button>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm" x-on:click="logCompute()">
                        🎯 Fit Logistic Model
                    </button>
                </div>

                <!-- Threshold slider -->
                <div x-show="logHasResult" x-transition class="mb-3">
                    <label class="form-label small fw-semibold">Classification Threshold</label>
                    <input type="range" class="form-range" x-model.number="logThreshold" min="0" max="1" step="0.05">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>0</span>
                        <span x-text="'Threshold = ' + logThreshold.toFixed(2)"></span>
                        <span>1</span>
                    </div>
                </div>

                <!-- Results -->
                <div x-show="logHasResult" x-transition>
                    <div class="prob-result-grid" style="grid-template-columns:1fr 1fr;">
                        <div class="prob-result-item">
                            <div class="prob-result-label">β₀ (intercept)</div>
                            <div class="prob-result-value" x-text="logBeta0"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">β₁ (slope)</div>
                            <div class="prob-result-value" x-text="logBeta1"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">Accuracy (t=<span x-text="logThreshold.toFixed(2)"></span>)</div>
                            <div class="prob-result-value" x-text="logAccuracyAtThreshold"></div>
                        </div>
                        <div class="prob-result-item">
                            <div class="prob-result-label">Equation</div>
                            <div class="prob-result-value" style="font-size:.75rem;" x-text="'P = 1/(1+e^(-(' + logBeta0 + '+' + logBeta1 + 'x)))'"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="stat-chart-container stat-chart-container-tall" x-show="logHasResult" x-cloak>
                    <h6 class="small fw-bold mb-2">Scatter &amp; Sigmoid Curve</h6>
                    <canvas id="logChart"></canvas>
                </div>
                <div x-show="!logHasResult" class="text-center text-muted py-5">
                    <div style="font-size: 3rem; opacity: 0.2;">🎯</div>
                    <p class="small mb-0 mt-2">Enter X (predictor) and Y (0/1 outcome), then click <strong>Fit Logistic Model</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden forms for anti-forgery tokens -->
<form id="stats-form-compute" method="post" asp-page-handler="Compute" style="display:none">
    <input type="hidden" name="data" />
</form>
<form id="stats-form-viz" method="post" asp-page-handler="Visualize" style="display:none">
    <input type="hidden" name="data" />
</form>
<form id="stats-form-csv" method="post" asp-page-handler="UploadCsv" enctype="multipart/form-data" style="display:none"></form>
<form id="stats-form-reg" method="post" asp-page-handler="Regression" style="display:none">
    <input type="hidden" name="dataX" />
    <input type="hidden" name="dataY" />
    <input type="hidden" name="degree" />
</form>
