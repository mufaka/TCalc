@page
@model TCalc.Web.Pages.ProbabilityModel
@{
    ViewData["Title"] = "Probability";
}

<div x-data="probabilityApp()" x-cloak>

    <!-- ─── Header ─── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="calc-title mb-0">🎲 Probability</h1>
            <p class="text-muted mb-0" style="font-size:.9rem;">
                Interactive probability concepts, rules, and calculations
            </p>
        </div>
    </div>

    <!-- ─── Section Tabs ─── -->
    <div class="prob-type-selector mb-4">
        <button type="button" class="prob-type-btn"
                :class="tab === 'basic' && 'active'"
                @@click="tab = 'basic'">Basic Concepts</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'conditional' && 'active'"
                @@click="tab = 'conditional'">Conditional</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'addition' && 'active'"
                @@click="tab = 'addition'">Addition Rule</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'multiplication' && 'active'"
                @@click="tab = 'multiplication'">Multiplication Rule</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'experimental' && 'active'"
                @@click="tab = 'experimental'">Experimental</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'table' && 'active'"
                @@click="tab = 'table'; $nextTick(() => initDistChart())">Distribution Table</button>
        <button type="button" class="prob-type-btn"
                :class="tab === 'joint' && 'active'"
                @@click="tab = 'joint'; $nextTick(() => initJointChart())">Joint Probability</button>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 1 — Basic Concepts: P(A) = favourable / total
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'basic'" x-transition>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Theoretical Probability</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        P(A) = <em>favourable outcomes</em> ÷ <em>total outcomes</em>
                    </p>

                    <div class="mb-3">
                        <label class="form-label">Favourable outcomes</label>
                        <input type="number" class="form-control" min="0"
                               x-model.number="basic.favourable"
                               @@input="computeBasic()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Total outcomes (sample space)</label>
                        <input type="number" class="form-control" min="1"
                               x-model.number="basic.total"
                               @@input="computeBasic()" />
                    </div>

                    <template x-if="basic.error">
                        <div class="text-danger mb-2" style="font-size:.85rem;" x-text="basic.error"></div>
                    </template>

                    <template x-if="basic.probability !== null && !basic.error">
                        <div class="prob-result-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A)</span>
                                <span class="prob-stat-value" x-text="fmt(basic.probability)"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A) %</span>
                                <span class="prob-stat-value" x-text="fmt(basic.probability * 100) + '%'"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(not A)</span>
                                <span class="prob-stat-value" x-text="fmt(1 - basic.probability)"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">Odds (A : not A)</span>
                                <span class="prob-stat-value"
                                      x-text="basic.favourable + ' : ' + (basic.total - basic.favourable)"></span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Probability Line visualisation -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Probability Line</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        Every probability falls between 0 (impossible) and 1 (certain). The sum of all outcomes = 1.
                    </p>
                    <svg viewBox="0 0 500 100" class="w-100" style="max-height:120px;">
                        <!-- Track -->
                        <line x1="40" y1="50" x2="460" y2="50"
                              stroke="var(--tc-border)" stroke-width="3" stroke-linecap="round" />
                        <!-- Ticks -->
                        <template x-for="i in 11">
                            <g>
                                <line :x1="40 + (i-1)*42" y1="40" :x2="40 + (i-1)*42" y2="60"
                                      stroke="var(--tc-text-muted)" stroke-width="1.5" />
                                <text :x="40 + (i-1)*42" y="78" text-anchor="middle"
                                      fill="var(--tc-text-muted)" font-size="11"
                                      x-text="((i-1)/10).toFixed(1)"></text>
                            </g>
                        </template>
                        <!-- Labels -->
                        <text x="40" y="28" text-anchor="middle" fill="var(--tc-text-muted)" font-size="10">Impossible</text>
                        <text x="250" y="28" text-anchor="middle" fill="var(--tc-text-muted)" font-size="10">Even chance</text>
                        <text x="460" y="28" text-anchor="middle" fill="var(--tc-text-muted)" font-size="10">Certain</text>
                        <!-- Marker -->
                        <template x-if="basic.probability !== null && !basic.error">
                            <g>
                                <circle :cx="40 + basic.probability * 420" cy="50" r="8"
                                        fill="var(--tc-primary)" opacity="0.9" />
                                <text :x="40 + basic.probability * 420" y="96" text-anchor="middle"
                                      fill="var(--tc-primary)" font-size="12" font-weight="700"
                                      x-text="'P(A) = ' + fmt(basic.probability)"></text>
                            </g>
                        </template>
                    </svg>

                    <!-- Sample space grid -->
                    <template x-if="basic.total > 0 && basic.total <= 120 && !basic.error">
                        <div>
                            <p class="text-muted mt-3 mb-2" style="font-size:.82rem;">
                                Sample space (<span x-text="basic.total"></span> outcomes,
                                <span x-text="basic.favourable" class="fw-bold" style="color:var(--tc-primary)"></span> favourable):
                            </p>
                            <div class="d-flex flex-wrap gap-1">
                                <template x-for="i in basic.total">
                                    <div class="prob-sample-cell"
                                         :class="i <= basic.favourable ? 'prob-sample-hit' : ''">
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 2 — Conditional Probability: P(A|B) = P(A ∩ B) / P(B)
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'conditional'" x-transition>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Conditional Probability</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        P(A | B) = P(A ∩ B) ÷ P(B) — the probability of A given that B has occurred.
                    </p>

                    <div class="mb-3">
                        <label class="form-label">P(A ∩ B) — both A and B</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="cond.pAB"
                               @@input="computeConditional()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">P(B)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="cond.pB"
                               @@input="computeConditional()" />
                    </div>

                    <template x-if="cond.error">
                        <div class="text-danger mb-2" style="font-size:.85rem;" x-text="cond.error"></div>
                    </template>

                    <template x-if="cond.result !== null && !cond.error">
                        <div class="prob-result-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A | B)</span>
                                <span class="prob-stat-value" x-text="fmt(cond.result)"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A | B) %</span>
                                <span class="prob-stat-value" x-text="fmt(cond.result * 100) + '%'"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">Interpretation</span>
                                <span class="prob-stat-value" style="font-size:.78rem;max-width:60%;text-align:right;"
                                      x-text="'Given B occurred, there is a ' + fmt(cond.result * 100) + '% chance A also occurs.'"></span>
                            </div>
                        </div>
                    </template>

                    <!-- Reverse conditional via Bayes -->
                    <div class="mt-3 pt-3" style="border-top:1px solid var(--tc-border);">
                        <p class="text-muted mb-2" style="font-size:.82rem;">
                            <strong>Bayes' Theorem</strong>: supply P(A) to also compute P(B | A).
                        </p>
                        <div class="mb-3">
                            <label class="form-label">P(A) <span class="text-muted">(optional)</span></label>
                            <input type="number" class="form-control" min="0" max="1" step="0.01"
                                   x-model.number="cond.pA"
                                   @@input="computeConditional()" />
                        </div>
                        <template x-if="cond.pBgivenA !== null && !cond.error">
                            <div class="prob-result-card">
                                <div class="d-flex justify-content-between">
                                    <span class="prob-stat-label">P(B | A)</span>
                                    <span class="prob-stat-value" x-text="fmt(cond.pBgivenA)"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Venn diagram -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Venn Diagram</h2>
                    <svg viewBox="0 0 420 280" class="w-100" style="max-height:320px;">
                        <!-- Universe -->
                        <rect x="10" y="10" width="400" height="260" rx="12"
                              fill="none" stroke="var(--tc-border)" stroke-width="1.5" />
                        <text x="20" y="30" fill="var(--tc-text-muted)" font-size="11">S (Sample Space)</text>

                        <!-- Circle B -->
                        <circle cx="250" cy="140" r="95"
                                fill="var(--tc-primary)" opacity="0.12"
                                stroke="var(--tc-primary)" stroke-width="2" />
                        <text x="310" y="90" fill="var(--tc-primary)" font-size="13" font-weight="700">B</text>

                        <!-- Circle A -->
                        <circle cx="180" cy="140" r="95"
                                fill="var(--tc-gradient-to)" opacity="0.12"
                                stroke="var(--tc-gradient-to)" stroke-width="2" />
                        <text x="115" y="90" fill="var(--tc-gradient-to)" font-size="13" font-weight="700">A</text>

                        <!-- Intersection highlight -->
                        <clipPath id="clipB">
                            <circle cx="250" cy="140" r="95" />
                        </clipPath>
                        <circle cx="180" cy="140" r="95"
                                clip-path="url(#clipB)"
                                fill="var(--tc-primary)" opacity="0.3" />

                        <!-- Intersection label -->
                        <text x="215" y="136" text-anchor="middle"
                              fill="var(--tc-text)" font-size="12" font-weight="600">A ∩ B</text>
                        <text x="215" y="154" text-anchor="middle"
                              fill="var(--tc-text)" font-size="11"
                              x-text="cond.pAB != null ? fmt(cond.pAB) : '—'"></text>

                        <!-- P(B) label -->
                        <text x="300" y="145" text-anchor="middle"
                              fill="var(--tc-primary)" font-size="11"
                              x-text="cond.pB != null ? 'P(B) = ' + fmt(cond.pB) : ''"></text>

                        <!-- P(A) label -->
                        <text x="130" y="145" text-anchor="middle"
                              fill="var(--tc-gradient-to)" font-size="11"
                              x-text="cond.pA != null ? 'P(A) = ' + fmt(cond.pA) : ''"></text>

                        <!-- Result -->
                        <template x-if="cond.result !== null && !cond.error">
                            <text x="210" y="260" text-anchor="middle"
                                  fill="var(--tc-text)" font-size="13" font-weight="700"
                                  x-text="'P(A | B) = ' + fmt(cond.result)"></text>
                        </template>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 3 — Addition Rule: P(A ∪ B) = P(A) + P(B) − P(A ∩ B)
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'addition'" x-transition>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Addition Rule (Or)</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        P(A ∪ B) = P(A) + P(B) − P(A ∩ B)
                    </p>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="addMutex"
                               x-model="add.mutuallyExclusive"
                               @@change="if(add.mutuallyExclusive) add.pAB = 0; computeAddition();" />
                        <label class="form-check-label" for="addMutex">
                            Mutually exclusive (A ∩ B = 0)
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">P(A)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="add.pA" @@input="computeAddition()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">P(B)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="add.pB" @@input="computeAddition()" />
                    </div>
                    <div class="mb-3" x-show="!add.mutuallyExclusive">
                        <label class="form-label">P(A ∩ B)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="add.pAB" @@input="computeAddition()" />
                    </div>

                    <template x-if="add.error">
                        <div class="text-danger mb-2" style="font-size:.85rem;" x-text="add.error"></div>
                    </template>

                    <template x-if="add.result !== null && !add.error">
                        <div class="prob-result-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A ∪ B)</span>
                                <span class="prob-stat-value" x-text="fmt(add.result)"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A ∪ B) %</span>
                                <span class="prob-stat-value" x-text="fmt(add.result * 100) + '%'"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(neither)</span>
                                <span class="prob-stat-value" x-text="fmt(1 - add.result)"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">Formula used</span>
                                <span class="prob-stat-value" style="font-size:.78rem;"
                                      x-text="add.mutuallyExclusive
                                          ? fmt(add.pA) + ' + ' + fmt(add.pB) + ' = ' + fmt(add.result)
                                          : fmt(add.pA) + ' + ' + fmt(add.pB) + ' − ' + fmt(add.pAB) + ' = ' + fmt(add.result)">
                                </span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Venn diagram — Addition -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Venn Diagram — A ∪ B</h2>
                    <svg viewBox="0 0 420 280" class="w-100" style="max-height:320px;">
                        <rect x="10" y="10" width="400" height="260" rx="12"
                              fill="none" stroke="var(--tc-border)" stroke-width="1.5" />
                        <text x="20" y="30" fill="var(--tc-text-muted)" font-size="11">S</text>

                        <!-- Dynamically separate circles when mutually exclusive -->
                        <circle :cx="add.mutuallyExclusive ? 155 : 180" cy="140" r="90"
                                fill="var(--tc-gradient-to)" opacity="0.18"
                                stroke="var(--tc-gradient-to)" stroke-width="2" />
                        <text :x="add.mutuallyExclusive ? 110 : 120" y="90"
                              fill="var(--tc-gradient-to)" font-size="13" font-weight="700">A</text>

                        <circle :cx="add.mutuallyExclusive ? 275 : 250" cy="140" r="90"
                                fill="var(--tc-primary)" opacity="0.18"
                                stroke="var(--tc-primary)" stroke-width="2" />
                        <text :x="add.mutuallyExclusive ? 320 : 310" y="90"
                              fill="var(--tc-primary)" font-size="13" font-weight="700">B</text>

                        <!-- Intersection shading (only when not mutually exclusive) -->
                        <template x-if="!add.mutuallyExclusive">
                            <g>
                                <clipPath id="clipAddB">
                                    <circle cx="250" cy="140" r="90" />
                                </clipPath>
                                <circle cx="180" cy="140" r="90"
                                        clip-path="url(#clipAddB)"
                                        fill="var(--tc-primary)" opacity="0.3" />
                                <text x="215" y="140" text-anchor="middle"
                                      fill="var(--tc-text)" font-size="11"
                                      x-text="add.pAB != null ? 'A∩B=' + fmt(add.pAB) : ''"></text>
                            </g>
                        </template>

                        <!-- P labels -->
                        <text :x="add.mutuallyExclusive ? 155 : 145" y="150" text-anchor="middle"
                              fill="var(--tc-gradient-to)" font-size="11"
                              x-text="add.pA != null ? fmt(add.pA) : ''"></text>
                        <text :x="add.mutuallyExclusive ? 275 : 285" y="150" text-anchor="middle"
                              fill="var(--tc-primary)" font-size="11"
                              x-text="add.pB != null ? fmt(add.pB) : ''"></text>

                        <!-- Result -->
                        <template x-if="add.result !== null && !add.error">
                            <text x="210" y="260" text-anchor="middle"
                                  fill="var(--tc-text)" font-size="13" font-weight="700"
                                  x-text="'P(A ∪ B) = ' + fmt(add.result)"></text>
                        </template>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 4 — Multiplication Rule: P(A ∩ B)
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'multiplication'" x-transition>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Multiplication Rule (And)</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        Independent: P(A ∩ B) = P(A) × P(B)<br />
                        Dependent: P(A ∩ B) = P(A) × P(B | A)
                    </p>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="mulIndep"
                               x-model="mul.independent"
                               @@change="computeMultiplication()" />
                        <label class="form-check-label" for="mulIndep">
                            Events are independent
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">P(A)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="mul.pA" @@input="computeMultiplication()" />
                    </div>

                    <template x-if="mul.independent">
                        <div class="mb-3">
                            <label class="form-label">P(B)</label>
                            <input type="number" class="form-control" min="0" max="1" step="0.01"
                                   x-model.number="mul.pB" @@input="computeMultiplication()" />
                        </div>
                    </template>
                    <template x-if="!mul.independent">
                        <div class="mb-3">
                            <label class="form-label">P(B | A) — probability of B given A</label>
                            <input type="number" class="form-control" min="0" max="1" step="0.01"
                                   x-model.number="mul.pBgivenA" @@input="computeMultiplication()" />
                        </div>
                    </template>

                    <template x-if="mul.error">
                        <div class="text-danger mb-2" style="font-size:.85rem;" x-text="mul.error"></div>
                    </template>

                    <template x-if="mul.result !== null && !mul.error">
                        <div class="prob-result-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A ∩ B)</span>
                                <span class="prob-stat-value" x-text="fmt(mul.result)"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">P(A ∩ B) %</span>
                                <span class="prob-stat-value" x-text="fmt(mul.result * 100) + '%'"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">Formula used</span>
                                <span class="prob-stat-value" style="font-size:.78rem;"
                                      x-text="mul.independent
                                          ? fmt(mul.pA) + ' × ' + fmt(mul.pB) + ' = ' + fmt(mul.result)
                                          : fmt(mul.pA) + ' × ' + fmt(mul.pBgivenA) + ' = ' + fmt(mul.result)">
                                </span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Tree diagram -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Tree Diagram</h2>
                    <svg viewBox="0 0 460 300" class="w-100" style="max-height:340px;">
                        <!-- Root -->
                        <circle cx="60" cy="150" r="6" fill="var(--tc-text-muted)" />
                        <text x="30" y="155" fill="var(--tc-text-muted)" font-size="11">Start</text>

                        <!-- Branch A -->
                        <line x1="66" y1="150" x2="170" y2="70" stroke="var(--tc-gradient-to)" stroke-width="2" />
                        <text x="100" y="95" fill="var(--tc-gradient-to)" font-size="11" font-weight="600"
                              x-text="mul.pA != null ? 'P(A)=' + fmt(mul.pA) : 'P(A)'"></text>
                        <circle cx="175" cy="68" r="5" fill="var(--tc-gradient-to)" />
                        <text x="178" y="58" fill="var(--tc-gradient-to)" font-size="12" font-weight="700">A</text>

                        <!-- Branch not-A -->
                        <line x1="66" y1="150" x2="170" y2="230" stroke="var(--tc-text-muted)" stroke-width="1.5" stroke-dasharray="4" />
                        <text x="92" y="210" fill="var(--tc-text-muted)" font-size="11"
                              x-text="mul.pA != null ? 'P(A\u2032)=' + fmt(1-mul.pA) : 'P(A\u2032)'"></text>
                        <circle cx="175" cy="232" r="4" fill="var(--tc-text-muted)" />
                        <text x="178" y="245" fill="var(--tc-text-muted)" font-size="11">A′</text>

                        <!-- From A → B -->
                        <line x1="180" y1="68" x2="310" y2="35" stroke="var(--tc-primary)" stroke-width="2" />
                        <text x="225" y="42" fill="var(--tc-primary)" font-size="10" font-weight="600"
                              x-text="mul.independent
                                  ? (mul.pB != null ? 'P(B)=' + fmt(mul.pB) : 'P(B)')
                                  : (mul.pBgivenA != null ? 'P(B|A)=' + fmt(mul.pBgivenA) : 'P(B|A)')">
                        </text>
                        <circle cx="315" cy="33" r="5" fill="var(--tc-primary)" />
                        <text x="322" y="28" fill="var(--tc-primary)" font-size="12" font-weight="700">A ∩ B</text>

                        <!-- Result at leaf -->
                        <template x-if="mul.result !== null && !mul.error">
                            <text x="322" y="46" fill="var(--tc-text)" font-size="11" font-weight="600"
                                  x-text="'= ' + fmt(mul.result)"></text>
                        </template>

                        <!-- From A → not-B -->
                        <line x1="180" y1="68" x2="310" y2="100" stroke="var(--tc-text-muted)" stroke-width="1.5" stroke-dasharray="4" />
                        <text x="232" y="97" fill="var(--tc-text-muted)" font-size="10"
                              x-text="mul.independent
                                  ? (mul.pB != null ? 'P(B\u2032)=' + fmt(1-mul.pB) : 'P(B\u2032)')
                                  : (mul.pBgivenA != null ? 'P(B\u2032|A)=' + fmt(1-mul.pBgivenA) : 'P(B\u2032|A)')">
                        </text>
                        <circle cx="315" cy="102" r="4" fill="var(--tc-text-muted)" />
                        <text x="322" y="106" fill="var(--tc-text-muted)" font-size="11">A ∩ B′</text>

                        <!-- Legend box -->
                        <rect x="280" y="250" width="170" height="38" rx="6"
                              fill="var(--tc-bg-elevated)" stroke="var(--tc-border)" stroke-width="1" />
                        <text x="365" y="268" text-anchor="middle" fill="var(--tc-text-muted)" font-size="10">
                            <tspan x-text="mul.independent ? 'Independent events' : 'Dependent events'"></tspan>
                        </text>
                        <text x="365" y="282" text-anchor="middle" fill="var(--tc-text-muted)" font-size="10"
                              x-text="mul.independent ? 'P(A∩B) = P(A) × P(B)' : 'P(A∩B) = P(A) × P(B|A)'"></text>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 5 — Experimental Probability (Simulation)
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'experimental'" x-transition>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Experimental Probability</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        Run trials and observe how experimental probability converges to theoretical probability
                        as the number of trials increases (Law of Large Numbers).
                    </p>

                    <!-- Experiment type -->
                    <div class="mb-3">
                        <label class="form-label">Experiment</label>
                        <select class="form-select" x-model="exp.type" @@change="resetExperiment()">
                            <option value="coin">Coin Flip (P = 0.5)</option>
                            <option value="die">Dice Roll — specific number (P = 1/6)</option>
                            <option value="custom">Custom probability</option>
                        </select>
                    </div>

                    <div class="mb-3" x-show="exp.type === 'custom'">
                        <label class="form-label">Theoretical P(success)</label>
                        <input type="number" class="form-control" min="0" max="1" step="0.01"
                               x-model.number="exp.customP" @@input="resetExperiment()" />
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-primary flex-fill"
                                @@click="runTrials(1)">+1 Trial</button>
                        <button type="button" class="btn btn-primary flex-fill"
                                @@click="runTrials(10)">+10</button>
                        <button type="button" class="btn btn-primary flex-fill"
                                @@click="runTrials(100)">+100</button>
                        <button type="button" class="btn btn-primary flex-fill"
                                @@click="runTrials(1000)">+1000</button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary w-100 mb-3"
                            @@click="resetExperiment()">Reset</button>

                    <div class="prob-result-card">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="prob-stat-label">Total trials</span>
                            <span class="prob-stat-value" x-text="exp.total"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="prob-stat-label">Successes</span>
                            <span class="prob-stat-value" x-text="exp.successes"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="prob-stat-label">Experimental P</span>
                            <span class="prob-stat-value"
                                  x-text="exp.total > 0 ? fmt(exp.successes / exp.total) : '—'"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="prob-stat-label">Theoretical P</span>
                            <span class="prob-stat-value" x-text="fmt(getTheoreticalP())"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="prob-stat-label">Difference</span>
                            <span class="prob-stat-value"
                                  x-text="exp.total > 0 ? fmt(Math.abs(exp.successes / exp.total - getTheoreticalP())) : '—'"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Convergence chart -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Convergence Chart</h2>
                    <p class="text-muted mb-2" style="font-size:.82rem;">
                        Watch experimental probability (blue) approach the theoretical value (dashed line) as trials increase.
                    </p>
                    <div class="prob-chart-container">
                        <canvas id="convergenceChart"></canvas>
                    </div>

                    <!-- Recent trials ribbon -->
                    <template x-if="exp.recentResults.length > 0">
                        <div class="mt-3">
                            <p class="text-muted mb-1" style="font-size:.82rem;">Last 20 trials:</p>
                            <div class="d-flex flex-wrap gap-1">
                                <template x-for="(r, i) in exp.recentResults" :key="i">
                                    <span class="prob-trial-pip"
                                          :class="r ? 'prob-trial-hit' : 'prob-trial-miss'"
                                          :title="r ? 'Success' : 'Fail'">
                                    </span>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 6 — Probability Distribution Table
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'table'" x-transition>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="calc-container">
                    <h2 class="calc-title">Probability Distribution Table</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        Enter outcomes and their probabilities. A valid distribution requires each P between 0 and 1
                        and all probabilities summing to exactly 1.
                    </p>

                    <!-- Preset loader -->
                    <div class="mb-3">
                        <label class="form-label">Load preset</label>
                        <select class="form-select form-select-sm" @@change="loadPreset($event.target.value); $event.target.value = ''">
                            <option value="">— choose —</option>
                            <option value="coin">Fair Coin</option>
                            <option value="die">Fair Die (6-sided)</option>
                            <option value="loaded">Loaded Die</option>
                            <option value="weather">Weather Forecast</option>
                        </select>
                    </div>

                    <!-- Distribution table -->
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0 prob-dist-table">
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th>Outcome (x)</th>
                                    <th style="width:140px;">P(x)</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="(row, i) in tbl.rows" :key="i">
                                    <tr>
                                        <td class="text-muted" x-text="i + 1" style="font-size:.82rem;"></td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="e.g. Heads"
                                                   x-model="row.outcome"
                                                   @@input="validateTable()" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm"
                                                   min="0" max="1" step="0.01" placeholder="0.5"
                                                   x-model.number="row.probability"
                                                   @@input="validateTable()"
                                                   :class="row.probability != null && (row.probability < 0 || row.probability > 1) ? 'is-invalid' : ''" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-0"
                                                    @@click="removeTableRow(i)"
                                                    :disabled="tbl.rows.length <= 1"
                                                    title="Remove row">&times;</button>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td></td>
                                    <td class="fw-bold text-end" style="font-size:.85rem;">ΣP(x) =</td>
                                    <td>
                                        <span class="fw-bold" style="font-size:.9rem;"
                                              :class="tbl.sumClass"
                                              x-text="tbl.sum != null ? fmt(tbl.sum) : '—'"></span>
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-3"
                            @@click="addTableRow()">+ Add Outcome</button>

                    <!-- Validation messages -->
                    <template x-if="tbl.errors.length > 0">
                        <div class="mb-3">
                            <template x-for="(err, i) in tbl.errors" :key="i">
                                <div class="text-danger mb-1" style="font-size:.83rem;">
                                    <span>⚠</span> <span x-text="err"></span>
                                </div>
                            </template>
                        </div>
                    </template>

                    <template x-if="tbl.valid">
                        <div class="text-success mb-3" style="font-size:.85rem;">
                            ✓ Valid probability distribution
                        </div>
                    </template>

                    <!-- Computed statistics (only if valid) -->
                    <template x-if="tbl.valid && tbl.stats">
                        <div class="prob-result-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">Number of outcomes</span>
                                <span class="prob-stat-value" x-text="tbl.rows.length"></span>
                            </div>
                            <template x-if="tbl.stats.hasNumeric">
                                <div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="prob-stat-label">Expected Value E(X)</span>
                                        <span class="prob-stat-value" x-text="fmt(tbl.stats.expectedValue)"></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="prob-stat-label">Variance Var(X)</span>
                                        <span class="prob-stat-value" x-text="fmt(tbl.stats.variance)"></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="prob-stat-label">Std Deviation σ</span>
                                        <span class="prob-stat-value" x-text="fmt(tbl.stats.stdDev)"></span>
                                    </div>
                                </div>
                            </template>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label">Most likely outcome</span>
                                <span class="prob-stat-value" x-text="tbl.stats.mode"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">Least likely outcome</span>
                                <span class="prob-stat-value" x-text="tbl.stats.least"></span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Bar chart visualisation -->
            <div class="col-lg-6">
                <div class="calc-container">
                    <h2 class="calc-title">Distribution Chart</h2>
                    <p class="text-muted mb-2" style="font-size:.82rem;">
                        Bar heights represent each outcome's probability. The dashed line marks a uniform distribution (1/n).
                    </p>
                    <div class="prob-chart-container">
                        <canvas id="distChart"></canvas>
                    </div>

                    <!-- Visual probability blocks -->
                    <template x-if="tbl.valid">
                        <div class="mt-3">
                            <p class="text-muted mb-2" style="font-size:.82rem;">Relative likelihood (100 blocks):</p>
                            <div class="d-flex flex-wrap gap-1">
                                <template x-for="(blk, i) in tbl.blocks" :key="i">
                                    <div class="prob-sample-cell prob-sample-hit"
                                         :style="'background-color:' + blk.color"
                                         :title="blk.outcome + ' — P=' + fmt(blk.probability)">
                                    </div>
                                </template>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <template x-for="(row, i) in tbl.rows" :key="'legend-'+i">
                                    <span style="font-size:.78rem;" class="d-inline-flex align-items-center gap-1">
                                        <span class="prob-sample-cell prob-sample-hit"
                                              :style="'background-color:' + getDistColor(i)"
                                              style="width:12px;height:12px;"></span>
                                        <span x-text="row.outcome || ('Outcome ' + (i+1))"></span>
                                    </span>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         Section 7 — Joint Probability
         ═══════════════════════════════════════════════════════════════ -->
    <div x-show="tab === 'joint'" x-transition>
        <div class="row g-4">
            <!-- Left column: table entry -->
            <div class="col-lg-7">
                <div class="calc-container">
                    <h2 class="calc-title">Joint Probability Table</h2>
                    <p class="text-muted" style="font-size:.85rem;">
                        Enter joint probabilities P(A∩B) for every combination of Event A (rows) and Event B (columns).
                        All cells must be between 0 and 1, and the grand total must equal 1.
                    </p>

                    <!-- Preset loader -->
                    <div class="mb-3">
                        <label class="form-label">Load preset</label>
                        <select class="form-select form-select-sm" @@change="loadJointPreset($event.target.value); $event.target.value = ''">
                            <option value="">— choose —</option>
                            <option value="gender_sport">Gender × Sport Preference</option>
                            <option value="weather_commute">Weather × Commute Mode</option>
                            <option value="dice_independent">Two Dice (Independent)</option>
                            <option value="grade_study">Grade × Study Hours</option>
                        </select>
                    </div>

                    <!-- Row/column controls -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div class="d-flex align-items-center gap-1">
                            <span style="font-size:.82rem;" class="text-muted">Event A (rows):</span>
                            <button type="button" class="btn btn-outline-primary btn-sm px-2 py-0" @@click="addJointRow()" title="Add row">+</button>
                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-0" @@click="removeJointRow()" :disabled="jt.rowLabels.length <= 1" title="Remove last row">−</button>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span style="font-size:.82rem;" class="text-muted">Event B (cols):</span>
                            <button type="button" class="btn btn-outline-primary btn-sm px-2 py-0" @@click="addJointCol()" title="Add column">+</button>
                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-0" @@click="removeJointCol()" :disabled="jt.colLabels.length <= 1" title="Remove last column">−</button>
                        </div>
                    </div>

                    <!-- Joint probability table -->
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0 prob-dist-table prob-joint-table">
                            <thead>
                                <tr>
                                    <th class="prob-joint-corner">A ╲ B</th>
                                    <template x-for="(cl, j) in jt.colLabels" :key="'ch-'+j">
                                        <th>
                                            <input type="text" class="form-control form-control-sm text-center prob-joint-label"
                                                   :placeholder="'B'+(j+1)"
                                                   x-model="jt.colLabels[j]"
                                                   @@input="validateJoint()" />
                                        </th>
                                    </template>
                                    <th class="prob-joint-marginal-hdr">P(A)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="(rl, i) in jt.rowLabels" :key="'r-'+i">
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control form-control-sm prob-joint-label"
                                                   :placeholder="'A'+(i+1)"
                                                   x-model="jt.rowLabels[i]"
                                                   @@input="validateJoint()" />
                                        </td>
                                        <template x-for="(cl, j) in jt.colLabels" :key="'c-'+i+'-'+j">
                                            <td>
                                                <input type="number" class="form-control form-control-sm text-center"
                                                       min="0" max="1" step="0.01" placeholder="0"
                                                       x-model.number="jt.cells[i][j]"
                                                       @@input="validateJoint()"
                                                       @@focus="jt.selRow = i; jt.selCol = j"
                                                       :class="jt.cells[i][j] != null && (jt.cells[i][j] < 0 || jt.cells[i][j] > 1) ? 'is-invalid' : (jt.selRow === i && jt.selCol === j ? 'prob-joint-selected' : '')" />
                                            </td>
                                        </template>
                                        <td class="prob-joint-marginal" x-text="jt.rowMarginals[i] != null ? fmt(jt.rowMarginals[i]) : '—'"></td>
                                    </tr>
                                </template>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="prob-joint-marginal-hdr fw-bold" style="font-size:.82rem;">P(B)</td>
                                    <template x-for="(cl, j) in jt.colLabels" :key="'cf-'+j">
                                        <td class="prob-joint-marginal" x-text="jt.colMarginals[j] != null ? fmt(jt.colMarginals[j]) : '—'"></td>
                                    </template>
                                    <td class="prob-joint-grand"
                                        :class="jt.grandTotal != null && Math.abs(jt.grandTotal - 1) <= 0.0001 ? 'text-success' : 'text-danger'"
                                        x-text="jt.grandTotal != null ? fmt(jt.grandTotal) : '—'"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Validation messages -->
                    <template x-if="jt.errors.length > 0">
                        <div class="mb-3">
                            <template x-for="(err, i) in jt.errors" :key="'je-'+i">
                                <div class="text-danger mb-1" style="font-size:.83rem;">
                                    <span>⚠</span> <span x-text="err"></span>
                                </div>
                            </template>
                        </div>
                    </template>

                    <template x-if="jt.valid">
                        <div class="text-success mb-3" style="font-size:.85rem;">
                            ✓ Valid joint probability distribution
                        </div>
                    </template>

                    <!-- Selected cell detail -->
                    <template x-if="jt.valid && jt.selRow != null && jt.selCol != null">
                        <div class="prob-result-card mb-3">
                            <h3 class="calc-subtitle mb-2" style="font-size:.9rem;">
                                Selected cell: <strong x-text="(jt.rowLabels[jt.selRow] || 'A'+(jt.selRow+1)) + ' ∩ ' + (jt.colLabels[jt.selCol] || 'B'+(jt.selCol+1))"></strong>
                            </h3>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label" x-text="'P(' + (jt.rowLabels[jt.selRow]||'A'+(jt.selRow+1)) + ' ∩ ' + (jt.colLabels[jt.selCol]||'B'+(jt.selCol+1)) + ')'"></span>
                                <span class="prob-stat-value" x-text="fmt(jt.cells[jt.selRow][jt.selCol])"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label" x-text="'P(' + (jt.rowLabels[jt.selRow]||'A'+(jt.selRow+1)) + ' | ' + (jt.colLabels[jt.selCol]||'B'+(jt.selCol+1)) + ')'"></span>
                                <span class="prob-stat-value" x-text="jt.colMarginals[jt.selCol] > 0 ? fmt(jt.cells[jt.selRow][jt.selCol] / jt.colMarginals[jt.selCol]) : '—'"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="prob-stat-label" x-text="'P(' + (jt.colLabels[jt.selCol]||'B'+(jt.selCol+1)) + ' | ' + (jt.rowLabels[jt.selRow]||'A'+(jt.selRow+1)) + ')'"></span>
                                <span class="prob-stat-value" x-text="jt.rowMarginals[jt.selRow] > 0 ? fmt(jt.cells[jt.selRow][jt.selCol] / jt.rowMarginals[jt.selRow]) : '—'"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="prob-stat-label">P(A)·P(B) (if independent)</span>
                                <span class="prob-stat-value" x-text="fmt(jt.rowMarginals[jt.selRow] * jt.colMarginals[jt.selCol])"></span>
                            </div>
                        </div>
                    </template>

                    <!-- Independence test -->
                    <template x-if="jt.valid">
                        <div class="prob-result-card">
                            <h3 class="calc-subtitle mb-2" style="font-size:.9rem;">Independence Test</h3>
                            <p class="text-muted mb-2" style="font-size:.82rem;">
                                Events are independent if P(A∩B) = P(A)·P(B) for <em>every</em> cell.
                            </p>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-bold" style="font-size:.9rem;"
                                      :class="jt.independent ? 'text-success' : 'text-warning'"
                                      x-text="jt.independent ? '✓ Events appear independent' : '✗ Events are NOT independent'"></span>
                            </div>
                            <div class="text-muted" style="font-size:.8rem;" x-show="!jt.independent">
                                Max deviation: <span x-text="fmt(jt.maxDeviation)"></span>
                                — at cell <span x-text="jt.maxDeviationCell"></span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Right column: heatmap + marginal charts -->
            <div class="col-lg-5">
                <div class="calc-container">
                    <h2 class="calc-title">Joint Distribution Heatmap</h2>
                    <p class="text-muted mb-2" style="font-size:.82rem;">
                        Cell colour intensity reflects probability magnitude. Click a cell in the table to see conditional probabilities.
                    </p>

                    <!-- SVG heatmap -->
                    <div class="prob-joint-heatmap-wrap mb-3">
                        <svg :viewBox="'0 0 ' + (jt.colLabels.length * 70 + 100) + ' ' + (jt.rowLabels.length * 50 + 80)"
                             class="prob-joint-heatmap" preserveAspectRatio="xMidYMid meet">
                            <!-- Column headers -->
                            <template x-for="(cl, j) in jt.colLabels" :key="'hc-'+j">
                                <text :x="80 + j * 70 + 35" y="18" text-anchor="middle"
                                      style="font-size:12px; fill: var(--tc-text-muted);"
                                      x-text="cl || ('B'+(j+1))"></text>
                            </template>
                            <!-- Row headers -->
                            <template x-for="(rl, i) in jt.rowLabels" :key="'hr-'+i">
                                <text x="72" :y="48 + i * 50 + 25" text-anchor="end"
                                      style="font-size:12px; fill: var(--tc-text-muted);"
                                      x-text="rl || ('A'+(i+1))"></text>
                            </template>
                            <!-- Cells -->
                            <template x-for="(rl, i) in jt.rowLabels" :key="'hri-'+i">
                                <template x-for="(cl, j) in jt.colLabels" :key="'hcj-'+i+'-'+j">
                                    <g>
                                        <rect :x="80 + j * 70" :y="28 + i * 50"
                                              width="66" height="44" rx="4"
                                              :fill="getHeatColor(jt.cells[i] ? jt.cells[i][j] : 0)"
                                              :stroke="jt.selRow === i && jt.selCol === j ? 'var(--tc-accent)' : 'var(--tc-border)'"
                                              :stroke-width="jt.selRow === i && jt.selCol === j ? 2.5 : 1"
                                              style="cursor:pointer;"
                                              @@click="jt.selRow = i; jt.selCol = j" />
                                        <text :x="80 + j * 70 + 33" :y="28 + i * 50 + 27"
                                              text-anchor="middle" style="font-size:11px; fill: var(--tc-text); pointer-events:none;"
                                              x-text="jt.cells[i] && jt.cells[i][j] != null ? fmt(jt.cells[i][j]) : ''"></text>
                                    </g>
                                </template>
                            </template>
                            <!-- Row marginals -->
                            <template x-for="(rl, i) in jt.rowLabels" :key="'hm-'+i">
                                <text :x="80 + jt.colLabels.length * 70 + 10" :y="48 + i * 50 + 25"
                                      text-anchor="start"
                                      style="font-size:10px; fill: var(--tc-text-muted); font-style: italic;"
                                      x-text="jt.rowMarginals[i] != null ? fmt(jt.rowMarginals[i]) : ''"></text>
                            </template>
                            <!-- Column marginals -->
                            <template x-for="(cl, j) in jt.colLabels" :key="'hcm-'+j">
                                <text :x="80 + j * 70 + 33" :y="28 + jt.rowLabels.length * 50 + 16"
                                      text-anchor="middle"
                                      style="font-size:10px; fill: var(--tc-text-muted); font-style: italic;"
                                      x-text="jt.colMarginals[j] != null ? fmt(jt.colMarginals[j]) : ''"></text>
                            </template>
                        </svg>
                    </div>

                    <!-- Marginal distribution bar chart -->
                    <h3 class="calc-subtitle mb-2" style="font-size:.88rem;">Marginal Distributions</h3>
                    <div class="prob-chart-container" style="height:220px;">
                        <canvas id="jointMarginalChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Quick Reference ─── -->
    <div class="calc-container mt-4">
        <h2 class="calc-title">📋 Quick Reference</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Basic</div>
                    <div class="prob-ref-formula">P(A) = favourable ÷ total</div>
                    <div class="prob-ref-note">0 ≤ P(A) ≤ 1 &nbsp;•&nbsp; ΣP = 1</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Addition (Or)</div>
                    <div class="prob-ref-formula">P(A∪B) = P(A) + P(B) − P(A∩B)</div>
                    <div class="prob-ref-note">Mutually exclusive: P(A∪B) = P(A) + P(B)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Multiplication (And)</div>
                    <div class="prob-ref-formula">P(A∩B) = P(A) × P(B|A)</div>
                    <div class="prob-ref-note">Independent: P(A∩B) = P(A) × P(B)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Conditional</div>
                    <div class="prob-ref-formula">P(A|B) = P(A∩B) ÷ P(B)</div>
                    <div class="prob-ref-note">Given B has occurred</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Bayes' Theorem</div>
                    <div class="prob-ref-formula">P(B|A) = P(A|B)·P(B) ÷ P(A)</div>
                    <div class="prob-ref-note">Reverse conditional reasoning</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Complement</div>
                    <div class="prob-ref-formula">P(A′) = 1 − P(A)</div>
                    <div class="prob-ref-note">Probability of "not A"</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Distribution</div>
                    <div class="prob-ref-formula">ΣP(xᵢ) = 1 &nbsp;•&nbsp; E(X) = Σxᵢ·P(xᵢ)</div>
                    <div class="prob-ref-note">All probabilities must sum to 1</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="prob-ref-card">
                    <div class="prob-ref-title">Joint Probability</div>
                    <div class="prob-ref-formula">P(A) = Σⱼ P(A∩Bⱼ) &nbsp;•&nbsp; ΣΣP = 1</div>
                    <div class="prob-ref-note">Independent if P(A∩B) = P(A)·P(B) for all cells</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function probabilityApp() {
    let convergenceChart = null;
    let distChart = null;
    let jointChart = null;

    return {
        tab: 'basic',

        // ── Basic ──
        basic: { favourable: 3, total: 6, probability: null, error: null },

        // ── Conditional ──
        cond: { pAB: 0.15, pB: 0.4, pA: null, result: null, pBgivenA: null, error: null },

        // ── Addition ──
        add: { pA: 0.3, pB: 0.5, pAB: 0.1, mutuallyExclusive: false, result: null, error: null },

        // ── Multiplication ──
        mul: { pA: 0.6, pB: 0.3, pBgivenA: 0.5, independent: true, result: null, error: null },

        // ── Experimental ──
        exp: { type: 'coin', customP: 0.5, total: 0, successes: 0, history: [], recentResults: [] },

        // ── Distribution Table ──
        tbl: {
            rows: [
                { outcome: 'Heads', probability: 0.5 },
                { outcome: 'Tails', probability: 0.5 }
            ],
            sum: 1,
            sumClass: 'text-success',
            valid: true,
            errors: [],
            stats: null,
            blocks: []
        },

        // ── Joint Probability ──
        jt: {
            rowLabels: ['Male', 'Female'],
            colLabels: ['Football', 'Basketball', 'Tennis'],
            cells: [[0.20, 0.10, 0.15], [0.10, 0.20, 0.25]],
            rowMarginals: [],
            colMarginals: [],
            grandTotal: null,
            selRow: 0,
            selCol: 0,
            valid: false,
            errors: [],
            independent: false,
            maxDeviation: 0,
            maxDeviationCell: ''
        },

        init() {
            this.computeBasic();
            this.computeConditional();
            this.computeAddition();
            this.computeMultiplication();
            this.initConvergenceChart();
            this.validateTable();
            this.validateJoint();
        },

        fmt(v) { return v == null ? '—' : +parseFloat(v).toFixed(6) + ''; },

        // ── Basic ──
        computeBasic() {
            this.basic.error = null;
            this.basic.probability = null;
            const f = this.basic.favourable, t = this.basic.total;
            if (t == null || t <= 0) { this.basic.error = 'Total must be > 0.'; return; }
            if (f == null || f < 0) { this.basic.error = 'Favourable must be ≥ 0.'; return; }
            if (f > t) { this.basic.error = 'Favourable cannot exceed total.'; return; }
            this.basic.probability = f / t;
        },

        // ── Conditional ──
        computeConditional() {
            this.cond.error = null;
            this.cond.result = null;
            this.cond.pBgivenA = null;
            const pAB = this.cond.pAB, pB = this.cond.pB, pA = this.cond.pA;
            if (pAB == null || pB == null) return;
            if (pB <= 0) { this.cond.error = 'P(B) must be > 0.'; return; }
            if (pAB < 0 || pAB > 1 || pB < 0 || pB > 1) { this.cond.error = 'Probabilities must be between 0 and 1.'; return; }
            if (pAB > pB) { this.cond.error = 'P(A∩B) cannot exceed P(B).'; return; }
            this.cond.result = pAB / pB;
            // Bayes' theorem if P(A) given
            if (pA != null && pA > 0 && pA <= 1 && pAB <= pA) {
                this.cond.pBgivenA = pAB / pA;
            }
        },

        // ── Addition ──
        computeAddition() {
            this.add.error = null;
            this.add.result = null;
            const pA = this.add.pA, pB = this.add.pB;
            const pAB = this.add.mutuallyExclusive ? 0 : this.add.pAB;
            if (pA == null || pB == null) return;
            if (pA < 0 || pA > 1 || pB < 0 || pB > 1) { this.add.error = 'Probabilities must be between 0 and 1.'; return; }
            if (!this.add.mutuallyExclusive && (pAB == null || pAB < 0 || pAB > 1)) { this.add.error = 'P(A∩B) must be between 0 and 1.'; return; }
            if (pAB > pA || pAB > pB) { this.add.error = 'P(A∩B) cannot exceed P(A) or P(B).'; return; }
            const r = pA + pB - pAB;
            if (r > 1.0001) { this.add.error = 'Result exceeds 1 — check your inputs.'; return; }
            this.add.result = Math.min(r, 1);
        },

        // ── Multiplication ──
        computeMultiplication() {
            this.mul.error = null;
            this.mul.result = null;
            const pA = this.mul.pA;
            if (pA == null || pA < 0 || pA > 1) { this.mul.error = 'P(A) must be between 0 and 1.'; return; }
            if (this.mul.independent) {
                const pB = this.mul.pB;
                if (pB == null || pB < 0 || pB > 1) { this.mul.error = 'P(B) must be between 0 and 1.'; return; }
                this.mul.result = pA * pB;
            } else {
                const pBgA = this.mul.pBgivenA;
                if (pBgA == null || pBgA < 0 || pBgA > 1) { this.mul.error = 'P(B|A) must be between 0 and 1.'; return; }
                this.mul.result = pA * pBgA;
            }
        },

        // ── Experimental ──
        getTheoreticalP() {
            if (this.exp.type === 'coin') return 0.5;
            if (this.exp.type === 'die') return 1 / 6;
            return this.exp.customP || 0;
        },

        runTrials(n) {
            const p = this.getTheoreticalP();
            for (let i = 0; i < n; i++) {
                const success = Math.random() < p;
                if (success) this.exp.successes++;
                this.exp.total++;
                // Track recent results (last 20)
                this.exp.recentResults.push(success);
                if (this.exp.recentResults.length > 20) this.exp.recentResults.shift();
                // Record data-point every so often for the chart
                if (this.exp.total <= 20 || this.exp.total % Math.max(1, Math.floor(n / 20)) === 0 || i === n - 1) {
                    this.exp.history.push({ trial: this.exp.total, prob: this.exp.successes / this.exp.total });
                }
            }
            this.updateConvergenceChart();
        },

        resetExperiment() {
            this.exp.total = 0;
            this.exp.successes = 0;
            this.exp.history = [];
            this.exp.recentResults = [];
            this.updateConvergenceChart();
        },

        // ── Distribution Table ──
        distColors: [
            'rgba(79,110,247,0.75)', 'rgba(231,76,60,0.75)', 'rgba(46,204,113,0.75)',
            'rgba(241,196,15,0.75)', 'rgba(155,89,182,0.75)', 'rgba(230,126,34,0.75)',
            'rgba(26,188,156,0.75)', 'rgba(52,73,94,0.75)', 'rgba(192,57,43,0.75)',
            'rgba(22,160,133,0.75)', 'rgba(127,140,141,0.75)', 'rgba(44,62,80,0.75)'
        ],

        getDistColor(i) {
            return this.distColors[i % this.distColors.length];
        },

        addTableRow() {
            this.tbl.rows.push({ outcome: '', probability: null });
            this.validateTable();
        },

        removeTableRow(i) {
            if (this.tbl.rows.length <= 1) return;
            this.tbl.rows.splice(i, 1);
            this.validateTable();
        },

        loadPreset(preset) {
            if (!preset) return;
            const presets = {
                coin: [
                    { outcome: 'Heads', probability: 0.5 },
                    { outcome: 'Tails', probability: 0.5 }
                ],
                die: [
                    { outcome: '1', probability: 1/6 },
                    { outcome: '2', probability: 1/6 },
                    { outcome: '3', probability: 1/6 },
                    { outcome: '4', probability: 1/6 },
                    { outcome: '5', probability: 1/6 },
                    { outcome: '6', probability: 1/6 }
                ],
                loaded: [
                    { outcome: '1', probability: 0.1 },
                    { outcome: '2', probability: 0.1 },
                    { outcome: '3', probability: 0.1 },
                    { outcome: '4', probability: 0.1 },
                    { outcome: '5', probability: 0.1 },
                    { outcome: '6', probability: 0.5 }
                ],
                weather: [
                    { outcome: 'Sunny', probability: 0.45 },
                    { outcome: 'Cloudy', probability: 0.25 },
                    { outcome: 'Rainy', probability: 0.20 },
                    { outcome: 'Snowy', probability: 0.10 }
                ]
            };
            if (presets[preset]) {
                this.tbl.rows = presets[preset].map(r => ({ ...r }));
                this.validateTable();
                this.$nextTick(() => this.updateDistChart());
            }
        },

        validateTable() {
            const errors = [];
            let sum = 0;
            let allFilled = true;
            let hasAnyProb = false;

            for (let i = 0; i < this.tbl.rows.length; i++) {
                const row = this.tbl.rows[i];
                const label = row.outcome ? `"${row.outcome}"` : `Row ${i + 1}`;

                if (!row.outcome || row.outcome.trim() === '') {
                    errors.push(`${label}: outcome name is required.`);
                }

                if (row.probability == null || row.probability === '') {
                    allFilled = false;
                } else {
                    hasAnyProb = true;
                    const p = Number(row.probability);
                    if (isNaN(p)) {
                        errors.push(`${label}: probability must be a number.`);
                    } else if (p < 0) {
                        errors.push(`${label}: probability cannot be negative (got ${p}).`);
                    } else if (p > 1) {
                        errors.push(`${label}: probability cannot exceed 1 (got ${p}).`);
                    } else {
                        sum += p;
                    }
                }
            }

            // Check for duplicate outcomes
            const names = this.tbl.rows.map(r => (r.outcome || '').trim().toLowerCase()).filter(n => n !== '');
            const seen = new Set();
            for (const n of names) {
                if (seen.has(n)) {
                    errors.push(`Duplicate outcome "${n}" — each outcome must be unique.`);
                    break;
                }
                seen.add(n);
            }

            // Sum validation
            this.tbl.sum = hasAnyProb ? sum : null;
            const tolerance = 0.0001;
            if (allFilled && hasAnyProb) {
                if (Math.abs(sum - 1) > tolerance) {
                    errors.push(`Probabilities sum to ${this.fmt(sum)} — they must sum to exactly 1.`);
                }
            }

            // Sum display class
            if (this.tbl.sum != null) {
                this.tbl.sumClass = Math.abs(this.tbl.sum - 1) <= tolerance ? 'text-success' : 'text-danger';
            } else {
                this.tbl.sumClass = 'text-muted';
            }

            this.tbl.errors = errors;
            this.tbl.valid = errors.length === 0 && allFilled && hasAnyProb && Math.abs(sum - 1) <= tolerance;

            // Compute stats if valid
            this.tbl.stats = null;
            this.tbl.blocks = [];
            if (this.tbl.valid) {
                this.computeTableStats();
                this.buildBlocks();
            }

            this.$nextTick(() => this.updateDistChart());
        },

        computeTableStats() {
            const rows = this.tbl.rows;
            // Check if all outcomes are numeric
            const nums = rows.map(r => parseFloat(r.outcome));
            const hasNumeric = nums.every(n => !isNaN(n));

            let expectedValue = null;
            let variance = null;
            let stdDev = null;

            if (hasNumeric) {
                expectedValue = 0;
                for (let i = 0; i < rows.length; i++) {
                    expectedValue += nums[i] * rows[i].probability;
                }
                variance = 0;
                for (let i = 0; i < rows.length; i++) {
                    variance += rows[i].probability * Math.pow(nums[i] - expectedValue, 2);
                }
                stdDev = Math.sqrt(variance);
            }

            // Mode (highest probability)
            let maxP = -1, minP = 2, modeLabel = '', leastLabel = '';
            for (const row of rows) {
                if (row.probability > maxP) { maxP = row.probability; modeLabel = row.outcome; }
                if (row.probability < minP) { minP = row.probability; leastLabel = row.outcome; }
            }

            this.tbl.stats = {
                hasNumeric,
                expectedValue,
                variance,
                stdDev,
                mode: modeLabel + ' (P=' + this.fmt(maxP) + ')',
                least: leastLabel + ' (P=' + this.fmt(minP) + ')'
            };
        },

        buildBlocks() {
            const blocks = [];
            for (let i = 0; i < this.tbl.rows.length; i++) {
                const row = this.tbl.rows[i];
                const count = Math.round(row.probability * 100);
                const color = this.getDistColor(i);
                for (let j = 0; j < count; j++) {
                    blocks.push({ outcome: row.outcome, probability: row.probability, color });
                }
            }
            // Ensure exactly 100 blocks (handle rounding)
            while (blocks.length < 100) {
                blocks.push({ outcome: '', probability: 0, color: 'var(--tc-border)' });
            }
            this.tbl.blocks = blocks.slice(0, 100);
        },

        // ── Distribution Chart ──
        initDistChart() {
            this.$nextTick(() => {
                if (distChart) { this.updateDistChart(); return; }
                const canvas = document.getElementById('distChart');
                if (!canvas || typeof Chart === 'undefined') return;
                const ctx = canvas.getContext('2d');
                distChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: [],
                        datasets: [{
                            label: 'P(x)',
                            data: [],
                            backgroundColor: [],
                            borderColor: [],
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 300 },
                        plugins: {
                            legend: { display: false },
                            annotation: {}
                        },
                        scales: {
                            x: {
                                title: { display: true, text: 'Outcome', color: 'var(--tc-text-muted)' },
                                ticks: { color: 'var(--tc-text-muted)' },
                                grid: { display: false }
                            },
                            y: {
                                min: 0, max: 1,
                                title: { display: true, text: 'P(x)', color: 'var(--tc-text-muted)' },
                                ticks: { color: 'var(--tc-text-muted)' },
                                grid: { color: 'var(--tc-border)' }
                            }
                        }
                    }
                });
                this.updateDistChart();
            });
        },

        updateDistChart() {
            if (!distChart) return;
            const rows = this.tbl.rows;
            const labels = rows.map((r, i) => r.outcome || ('Outcome ' + (i + 1)));
            const data = rows.map(r => (r.probability != null && r.probability >= 0 && r.probability <= 1) ? r.probability : 0);
            const bgColors = rows.map((_, i) => this.getDistColor(i));
            const borderColors = bgColors.map(c => c.replace('0.75', '1'));

            distChart.data.labels = labels;
            distChart.data.datasets[0].data = data;
            distChart.data.datasets[0].backgroundColor = bgColors;
            distChart.data.datasets[0].borderColor = borderColors;

            // Adjust y-axis max
            const maxVal = Math.max(...data, 0.1);
            distChart.options.scales.y.max = Math.min(1, Math.ceil(maxVal * 10) / 10 + 0.1);

            distChart.update();
        },

        // ── Joint Probability ──
        addJointRow() {
            this.jt.rowLabels.push('');
            this.jt.cells.push(new Array(this.jt.colLabels.length).fill(0));
            this.validateJoint();
        },

        removeJointRow() {
            if (this.jt.rowLabels.length <= 1) return;
            this.jt.rowLabels.pop();
            this.jt.cells.pop();
            if (this.jt.selRow >= this.jt.rowLabels.length) this.jt.selRow = this.jt.rowLabels.length - 1;
            this.validateJoint();
        },

        addJointCol() {
            this.jt.colLabels.push('');
            for (let i = 0; i < this.jt.cells.length; i++) {
                this.jt.cells[i].push(0);
            }
            this.validateJoint();
        },

        removeJointCol() {
            if (this.jt.colLabels.length <= 1) return;
            this.jt.colLabels.pop();
            for (let i = 0; i < this.jt.cells.length; i++) {
                this.jt.cells[i].pop();
            }
            if (this.jt.selCol >= this.jt.colLabels.length) this.jt.selCol = this.jt.colLabels.length - 1;
            this.validateJoint();
        },

        loadJointPreset(preset) {
            if (!preset) return;
            const presets = {
                gender_sport: {
                    rowLabels: ['Male', 'Female'],
                    colLabels: ['Football', 'Basketball', 'Tennis'],
                    cells: [[0.20, 0.10, 0.15], [0.10, 0.20, 0.25]]
                },
                weather_commute: {
                    rowLabels: ['Sunny', 'Rainy', 'Snowy'],
                    colLabels: ['Drive', 'Bus', 'Walk'],
                    cells: [[0.25, 0.10, 0.15], [0.05, 0.20, 0.02], [0.03, 0.15, 0.05]]
                },
                dice_independent: {
                    rowLabels: ['Die A ≤ 3', 'Die A > 3'],
                    colLabels: ['Die B ≤ 3', 'Die B > 3'],
                    cells: [[0.25, 0.25], [0.25, 0.25]]
                },
                grade_study: {
                    rowLabels: ['A', 'B', 'C'],
                    colLabels: ['< 2 hrs', '2-5 hrs', '> 5 hrs'],
                    cells: [[0.02, 0.08, 0.20], [0.05, 0.20, 0.10], [0.18, 0.12, 0.05]]
                }
            };
            const p = presets[preset];
            if (!p) return;
            this.jt.rowLabels = [...p.rowLabels];
            this.jt.colLabels = [...p.colLabels];
            this.jt.cells = p.cells.map(r => [...r]);
            this.jt.selRow = 0;
            this.jt.selCol = 0;
            this.validateJoint();
            this.$nextTick(() => this.updateJointChart());
        },

        validateJoint() {
            const errors = [];
            const rows = this.jt.rowLabels.length;
            const cols = this.jt.colLabels.length;

            // Ensure cells array matches dimensions
            while (this.jt.cells.length < rows) this.jt.cells.push(new Array(cols).fill(0));
            for (let i = 0; i < rows; i++) {
                while (this.jt.cells[i].length < cols) this.jt.cells[i].push(0);
            }

            // Check labels
            const rlNames = this.jt.rowLabels.map(l => (l || '').trim().toLowerCase()).filter(n => n !== '');
            const clNames = this.jt.colLabels.map(l => (l || '').trim().toLowerCase()).filter(n => n !== '');
            const rlSeen = new Set();
            for (const n of rlNames) { if (rlSeen.has(n)) { errors.push(`Duplicate row label "${n}".`); break; } rlSeen.add(n); }
            const clSeen = new Set();
            for (const n of clNames) { if (clSeen.has(n)) { errors.push(`Duplicate column label "${n}".`); break; } clSeen.add(n); }

            // Validate cells & compute marginals
            let grandTotal = 0;
            let allFilled = true;
            const rowMarginals = new Array(rows).fill(0);
            const colMarginals = new Array(cols).fill(0);

            for (let i = 0; i < rows; i++) {
                for (let j = 0; j < cols; j++) {
                    const v = this.jt.cells[i][j];
                    if (v == null || v === '') {
                        allFilled = false;
                        continue;
                    }
                    const p = Number(v);
                    if (isNaN(p)) {
                        errors.push(`Cell (${i + 1},${j + 1}): not a number.`);
                    } else if (p < 0) {
                        errors.push(`Cell (${i + 1},${j + 1}): probability cannot be negative.`);
                    } else if (p > 1) {
                        errors.push(`Cell (${i + 1},${j + 1}): probability cannot exceed 1.`);
                    } else {
                        rowMarginals[i] += p;
                        colMarginals[j] += p;
                        grandTotal += p;
                    }
                }
            }

            this.jt.rowMarginals = rowMarginals;
            this.jt.colMarginals = colMarginals;
            this.jt.grandTotal = grandTotal;

            const tolerance = 0.0001;
            if (allFilled && Math.abs(grandTotal - 1) > tolerance) {
                errors.push(`Grand total is ${this.fmt(grandTotal)} — must equal 1.`);
            }

            this.jt.errors = errors;
            this.jt.valid = errors.length === 0 && allFilled && Math.abs(grandTotal - 1) <= tolerance;

            // Independence test
            this.jt.independent = false;
            this.jt.maxDeviation = 0;
            this.jt.maxDeviationCell = '';
            if (this.jt.valid) {
                let maxDev = 0;
                let maxCell = '';
                let isIndep = true;
                for (let i = 0; i < rows; i++) {
                    for (let j = 0; j < cols; j++) {
                        const expected = rowMarginals[i] * colMarginals[j];
                        const actual = this.jt.cells[i][j];
                        const dev = Math.abs(actual - expected);
                        if (dev > tolerance) isIndep = false;
                        if (dev > maxDev) {
                            maxDev = dev;
                            maxCell = (this.jt.rowLabels[i] || 'A'+(i+1)) + ' ∩ ' + (this.jt.colLabels[j] || 'B'+(j+1));
                        }
                    }
                }
                this.jt.independent = isIndep;
                this.jt.maxDeviation = maxDev;
                this.jt.maxDeviationCell = maxCell;
            }

            this.$nextTick(() => this.updateJointChart());
        },

        getHeatColor(p) {
            if (p == null || isNaN(p) || p < 0) return 'var(--tc-bg)';
            const intensity = Math.min(p / 0.35, 1);
            const r = Math.round(79 + (255 - 79) * (1 - intensity));
            const g = Math.round(110 + (255 - 110) * (1 - intensity));
            const b = Math.round(247 + (255 - 247) * (1 - intensity));
            return `rgba(${r},${g},${b},${0.15 + intensity * 0.6})`;
        },

        initJointChart() {
            this.$nextTick(() => {
                if (jointChart) { this.updateJointChart(); return; }
                const canvas = document.getElementById('jointMarginalChart');
                if (!canvas || typeof Chart === 'undefined') return;
                const ctx = canvas.getContext('2d');
                jointChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: [],
                        datasets: [
                            { label: 'P(A) — Row marginals', data: [], backgroundColor: 'rgba(79,110,247,0.65)', borderRadius: 4 },
                            { label: 'P(B) — Column marginals', data: [], backgroundColor: 'rgba(231,76,60,0.65)', borderRadius: 4 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 300 },
                        plugins: { legend: { display: true, labels: { color: 'var(--tc-text-muted)', font: { size: 11 } } } },
                        scales: {
                            x: {
                                ticks: { color: 'var(--tc-text-muted)', font: { size: 10 } },
                                grid: { display: false }
                            },
                            y: {
                                min: 0, max: 1,
                                title: { display: true, text: 'P', color: 'var(--tc-text-muted)' },
                                ticks: { color: 'var(--tc-text-muted)' },
                                grid: { color: 'var(--tc-border)' }
                            }
                        }
                    }
                });
                this.updateJointChart();
            });
        },

        updateJointChart() {
            if (!jointChart) return;
            const rowLabels = this.jt.rowLabels.map((l, i) => l || ('A' + (i + 1)));
            const colLabels = this.jt.colLabels.map((l, j) => l || ('B' + (j + 1)));
            // Combine labels — pad shorter array
            const maxLen = Math.max(rowLabels.length, colLabels.length);
            const labels = [];
            for (let k = 0; k < maxLen; k++) {
                const parts = [];
                if (k < rowLabels.length) parts.push(rowLabels[k]);
                if (k < colLabels.length) parts.push(colLabels[k]);
                labels.push(parts.join(' / '));
            }

            const rowData = [];
            const colData = [];
            for (let k = 0; k < maxLen; k++) {
                rowData.push(k < this.jt.rowMarginals.length ? this.jt.rowMarginals[k] : null);
                colData.push(k < this.jt.colMarginals.length ? this.jt.colMarginals[k] : null);
            }

            jointChart.data.labels = labels;
            jointChart.data.datasets[0].data = rowData;
            jointChart.data.datasets[1].data = colData;
            const maxVal = Math.max(...rowData.filter(v => v != null), ...colData.filter(v => v != null), 0.1);
            jointChart.options.scales.y.max = Math.min(1, Math.ceil(maxVal * 10) / 10 + 0.1);
            jointChart.update();
        },

        // ── Chart ──
        initConvergenceChart() {
            this.$nextTick(() => {
                const canvas = document.getElementById('convergenceChart');
                if (!canvas || typeof Chart === 'undefined') return;
                const ctx = canvas.getContext('2d');
                convergenceChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [],
                        datasets: [
                            {
                                label: 'Experimental P',
                                data: [],
                                borderColor: 'rgba(79,110,247,1)',
                                backgroundColor: 'rgba(79,110,247,0.1)',
                                fill: false,
                                tension: 0.3,
                                pointRadius: 0,
                                borderWidth: 2,
                            },
                            {
                                label: 'Theoretical P',
                                data: [],
                                borderColor: 'rgba(231,76,60,0.7)',
                                borderDash: [6, 4],
                                fill: false,
                                pointRadius: 0,
                                borderWidth: 2,
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 200 },
                        plugins: { legend: { display: true, labels: { color: 'var(--tc-text-muted)', font: { size: 11 } } } },
                        scales: {
                            x: {
                                title: { display: true, text: 'Trials', color: 'var(--tc-text-muted)' },
                                ticks: { color: 'var(--tc-text-muted)', maxTicksLimit: 10 },
                                grid: { color: 'var(--tc-border)' }
                            },
                            y: {
                                min: 0, max: 1,
                                title: { display: true, text: 'Probability', color: 'var(--tc-text-muted)' },
                                ticks: { color: 'var(--tc-text-muted)' },
                                grid: { color: 'var(--tc-border)' }
                            }
                        }
                    }
                });
            });
        },

        updateConvergenceChart() {
            if (!convergenceChart) return;
            const p = this.getTheoreticalP();
            convergenceChart.data.labels = this.exp.history.map(h => h.trial);
            convergenceChart.data.datasets[0].data = this.exp.history.map(h => h.prob);
            convergenceChart.data.datasets[1].data = this.exp.history.map(() => p);
            convergenceChart.update();
        }
    };
}
</script>
